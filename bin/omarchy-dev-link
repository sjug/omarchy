#!/bin/bash

# omarchy:summary=Point Omarchy at a local checkout after reboot
# omarchy:group=dev
# omarchy:args=<path-to-checkout> [--no-reboot] [--no-sudo-path]
# omarchy:examples=omarchy dev link ~/omarchy

set -euo pipefail

script_dir=$(cd -- "$(dirname -- "$(realpath "${BASH_SOURCE[0]}")")" && pwd)

if (( EUID == 0 )); then
  echo "Error: run omarchy-dev-link as your user, not under sudo." >&2
  exit 1
fi

prompt_reboot=1

if (( $# < 1 || $# > 3 )) || [[ $1 == "-h" || $1 == "--help" ]]; then
  cat <<USAGE
Usage: omarchy dev link <path-to-checkout> [--no-reboot] [--no-sudo-path]

Writes /etc/omarchy.conf so OMARCHY_PATH resolves to <path-to-checkout>
after reboot. This intentionally does not rewrite the running Hyprland,
systemd, shell, or app-launcher environment; reboot to make every layer agree.

Affects only \$OMARCHY_PATH-resolved trees: bin/, default/, shell/,
themes/, applications/, config/. Files installed at fixed system paths
(/etc/, /usr/lib/systemd/, udev rule bodies, /etc/skel after user
creation, /usr/share/plymouth) are NOT covered — for those, use
omarchy-dev-pkg-test to build and install the package from the checkout.

Also writes /etc/sudoers.d/omarchy-dev-path so sudo resolves omarchy-*
from the checkout instead of the packaged copies. That part takes effect
immediately, no reboot needed.

Use --no-reboot when another command will handle the reboot prompt.

Use --no-sudo-path to remove or omit the sudoers drop-in: the checkout's bin/
is user-writable, so putting it on root's secure_path is a trust grant fit for
a development machine, not a production desktop. omarchy-overlay-setup
links with this flag; omarchy commands still escalate internally, only a
literal \`sudo omarchy-<cmd>\` stops resolving from the checkout.
USAGE
  exit 0
fi

target_arg=$1
shift
install_sudo_path=1
while (($#)); do
  if [[ $1 == "--no-reboot" ]]; then
    prompt_reboot=0
    shift
  elif [[ $1 == "--no-sudo-path" ]]; then
    install_sudo_path=0
    shift
  else
    echo "Usage: omarchy dev link <path-to-checkout> [--no-reboot] [--no-sudo-path]" >&2
    exit 1
  fi
done

if ! installation_type=$("$script_dir/omarchy-installation-type" --classify-only); then
  echo "Error: refusing to change the Omarchy runtime link while installation state is invalid." >&2
  exit 1
fi
if [[ $installation_type == "desktop_overlay" ]]; then
  echo "Error: omarchy dev link cannot change a registered desktop overlay." >&2
  echo "Use 'omarchy overlay setup link' to repair its checkout link." >&2
  exit 1
fi

target=$(realpath -e "$target_arg" 2>/dev/null) || {
  echo "Error: path does not exist: $target_arg" >&2
  exit 1
}

for required in bin default shell; do
  if [[ ! -d $target/$required ]]; then
    echo "Warning: $target/$required not found — does this look like an Omarchy source checkout?" >&2
  fi
done

# Product commands live in /usr/bin while shared helpers live in the runtime
# tree. A dev-linked product resolves both from its active checkout.
# shellcheck source=../install/helpers/runtime-link.sh
source "$OMARCHY_PATH/install/helpers/runtime-link.sh"
omarchy_write_runtime_link "$target" "$install_sudo_path"
echo

if (( prompt_reboot )) && gum confirm "Reboot now to activate?"; then
  omarchy-system-reboot
fi
